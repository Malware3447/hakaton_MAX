# Скопируйте в .env и заполните. Без .env всё поднимается в режиме MAX_MODE=off.

# webhook — боевой бот на сервере; polling — свой тестовый бот; off — без MAX, заглушка
MAX_MODE=off
# Токен бота из MAX для партнёров. Нужен при MAX_MODE=webhook или polling
MAX_BOT_TOKEN=
# Секрет вебхука: MAX присылает его в заголовке X-Max-Bot-Api-Secret
MAX_WEBHOOK_SECRET=
# Публичный адрес, на который MAX шлёт вебхук: https://<домен>/bot/webhook
PUBLIC_URL=

# База. В compose адрес собирается сам из POSTGRES_*
POSTGRES_USER=nakladnaya
POSTGRES_PASSWORD=nakladnaya
POSTGRES_DB=nakladnaya

# Порт приложения на хосте
APP_PORT=3000
LOG_LEVEL=info
