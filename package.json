{
  "name": "nakladnaya-v-karmane",
  "private": true,
  "description": "Бот в MAX, который ведёт электронную транспортную накладную от отгрузки до четвёртого титула",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @nk/app",
    "build": "npm run build -w @nk/app",
    "start": "npm run start -w @nk/app",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "db:generate": "npm run db:generate -w @nk/app",
    "db:reset": "npm run db:reset -w @nk/app"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
