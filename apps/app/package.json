{
  "name": "@nk/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_EXTRA_CA_CERTS=../../certs/russian_trusted_root_ca.pem tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/main.js --external:pg-native --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "start": "node dist/main.js",
    "db:generate": "drizzle-kit generate",
    "db:reset": "tsx --env-file-if-exists=../../.env src/cli/reset.ts"
  },
  "dependencies": {
    "@nk/domain": "*",
    "@nk/etrn": "*",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "pino": "^10.3.1"
  }
}
