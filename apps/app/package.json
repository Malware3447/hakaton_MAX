{
  "name": "@nk/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/main.js --external:pg-native --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@nk/domain": "*",
    "@nk/etrn": "*",
    "fastify": "^5.12.5",
    "zod": "^4.6.5"
  }
}
